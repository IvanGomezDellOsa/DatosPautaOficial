// Worker del formulario de contacto. Lo despliega Workers Builds (Cloudflare) desde
// esta carpeta con `npx wrangler deploy`. Solo es accesible por el service binding
// CONTACTO del proyecto de Pages (sin URL workers.dev).
//
// DESTINO (la dirección que recibe los mensajes) es un secreto cargado en el panel
// de Cloudflare: no va en este archivo.
{
  "name": "datospautaoficial-contacto",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [{ "name": "CORREO" }],
  "observability": { "enabled": true }
}
