---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Datos Pauta Oficial",
  description = "Todos los datos públicos de pauta oficial de la Argentina, en un solo lugar.",
} = Astro.props;

// URL canónica por página (site viene de astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content="https://datospautaoficial.com.ar/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Datos Pauta Oficial" />
    <link rel="canonical" href={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://datospautaoficial.com.ar/og-image.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {/* Sin JS el IntersectionObserver del scroll-reveal nunca corre: las
        secciones .reveal quedarían en opacity:0. Este override las muestra. */}
    <noscript>
      <style>{`.reveal { opacity: 1 !important; transform: none !important; }`}</style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
