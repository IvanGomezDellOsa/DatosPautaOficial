---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Datos Pauta Oficial",
  description = "Todos los datos públicos de pauta oficial de la Argentina, en un solo lugar.",
} = Astro.props;

// URL canónica por página (site viene de astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content="https://datospautaoficial.com.ar/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Datos Pauta Oficial" />
    <link rel="canonical" href={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://datospautaoficial.com.ar/og-image.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {/* Sin JS el IntersectionObserver del scroll-reveal nunca corre: las
        secciones .reveal quedarían en opacity:0. Este override las muestra. */}
    <noscript>
      <style>{`.reveal { opacity: 1 !important; transform: none !important; }`}</style>
    </noscript>
  </head>
  <body>
    <slot />

    <script is:inline>
      // ─────────── Popout de contacto para links mailto: ───────────
      // En mobile el mailto: abre la app de correo y funciona bien. En desktop
      // suele no haber cliente de correo asociado y el click "no hace nada".
      // Acá: en dispositivos sin puntero táctil se intercepta el click y se
      // muestra una tarjeta con la dirección, botón de copiar y el mailto como
      // alternativa para quien sí tiene app configurada.
      (function () {
        var esTouch = window.matchMedia("(any-pointer: coarse)").matches;
        if (esTouch) return;

        var abierto = null;

        function cerrar() {
          if (!abierto) return;
          abierto.backdrop.remove();
          document.removeEventListener("keydown", abierto.onKey);
          if (abierto.trigger) abierto.trigger.focus();
          abierto = null;
        }

        function abrir(href, trigger) {
          cerrar();
          var email = href.replace(/^mailto:/, "").split("?")[0];

          var backdrop = document.createElement("div");
          backdrop.className = "mail-popover-backdrop";

          var card = document.createElement("div");
          card.className = "mail-popover";
          card.setAttribute("role", "dialog");
          card.setAttribute("aria-modal", "true");
          card.setAttribute("aria-label", "Contacto por email");
          card.innerHTML =
            '<button type="button" class="mail-popover-close" aria-label="Cerrar">×</button>' +
            '<div class="mail-popover-title">Contacto</div>' +
            '<div class="mail-popover-mail"></div>' +
            '<div class="mail-popover-actions">' +
            '  <button type="button" class="mail-popover-copy">Copiar email</button>' +
            '  <a class="mail-popover-open" href="' + href + '">Abrir en tu app de correo</a>' +
            "</div>";
          card.querySelector(".mail-popover-mail").textContent = email;

          card.querySelector(".mail-popover-close").addEventListener("click", cerrar);
          var btnCopy = card.querySelector(".mail-popover-copy");
          btnCopy.addEventListener("click", function () {
            navigator.clipboard.writeText(email).then(
              function () { btnCopy.textContent = "Copiado ✓"; setTimeout(cerrar, 900); },
              function () { btnCopy.textContent = "No se pudo copiar"; }
            );
          });
          backdrop.addEventListener("mousedown", function (e) {
            if (e.target === backdrop) cerrar();
          });
          var onKey = function (e) { if (e.key === "Escape") cerrar(); };
          document.addEventListener("keydown", onKey);

          backdrop.appendChild(card);
          document.body.appendChild(backdrop);
          abierto = { backdrop: backdrop, onKey: onKey, trigger: trigger };
          btnCopy.focus();
        }

        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href^="mailto:"]');
          if (!a) return;
          e.preventDefault();
          abrir(a.getAttribute("href"), a);
        });
      })();
    </script>
  </body>
</html>
