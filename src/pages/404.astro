---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Página no encontrada — Datos Pauta Oficial"
    description="La página que buscás no existe."
>
    <main class="nf">
        <div class="nf-wrap">
            <svg class="nf-flag" viewBox="0 0 16 10" aria-hidden="true">
                <rect width="16" height="3.33" y="0" fill="#74acdf"></rect>
                <rect width="16" height="3.34" y="3.33" fill="#ffffff"></rect>
                <rect width="16" height="3.33" y="6.67" fill="#74acdf"></rect>
            </svg>
            <h1>Página no encontrada</h1>
            <p>
                La dirección que abriste no existe. Los datos viven todos en la
                portada: tabla completa, buscador y rankings.
            </p>
            <a href="/" class="nf-btn">← Ir a los datos</a>
        </div>
    </main>
</Layout>

<style>
    .nf {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.25rem;
    }
    .nf-wrap {
        text-align: center;
        max-width: 420px;
    }
    .nf-flag {
        width: 48px;
        height: 30px;
        margin: 0 auto 1.5rem;
        border-radius: 4px;
    }
    .nf h1 {
        font-size: var(--text-h2);
        color: var(--color-fg-strong);
        margin: 0 0 0.75rem;
    }
    .nf p {
        color: var(--color-fg-muted);
        font-size: var(--text-body);
        line-height: 1.6;
        margin: 0 0 1.5rem;
    }
    .nf-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 1.1rem;
        background: var(--color-accent);
        color: var(--color-bg);
        font-weight: 600;
        font-size: var(--text-small);
        border-radius: 8px;
        text-decoration: none;
    }
</style>
